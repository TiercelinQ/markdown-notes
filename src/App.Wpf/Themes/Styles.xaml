<!-- ============================================================
     Styles.xaml - Markdown Notes v1.0.0
     Reference: design-system.md v1.0 (WPF) - layout.md v1.0
     Consumes resource keys only (Tokens.xaml and the Fluent brushes).
     ============================================================ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:models="clr-namespace:MarkdownNotes.Models"
                    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">

  <!-- ===== SHELL ===== -->

  <!-- Tokens: ApplicationBackgroundBrush, TextFillColorPrimaryBrush -->
  <Style x:Key="AppWindowStyle" TargetType="ui:FluentWindow" BasedOn="{StaticResource {x:Type ui:FluentWindow}}">
    <Setter Property="Background" Value="{DynamicResource ApplicationBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <!-- Tokens: TitleBarHeight. The application icon sits at the start of the title bar. -->
  <Style x:Key="AppTitleBarStyle" TargetType="ui:TitleBar" BasedOn="{StaticResource {x:Type ui:TitleBar}}">
    <Setter Property="Height" Value="{StaticResource TitleBarHeight}" />
    <Setter Property="Icon">
      <Setter.Value>
        <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== DIALOGS ===== -->

  <!-- Tokens: DialogContentMinWidth, TextFillColorPrimaryBrush.
       The dialog is as wide as its message: with a short message the three footer buttons were squeezed and their labels cut. -->
  <Style x:Key="DialogMessageStyle" TargetType="TextBlock">
    <Setter Property="MinWidth" Value="{StaticResource DialogContentMinWidth}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <!-- ===== MENU BAR ===== -->

  <!-- Tokens: MenuBarHeight, BorderBottom, ApplicationBackgroundBrush, ControlStrokeColorDefaultBrush -->
  <Style x:Key="MenuBarBorderStyle" TargetType="Border">
    <Setter Property="Height" Value="{StaticResource MenuBarHeight}" />
    <Setter Property="Background" Value="{DynamicResource ApplicationBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource BorderBottom}" />
  </Style>

  <!-- Tokens: FontSizeSm, TextFillColorPrimaryBrush -->
  <Style x:Key="AppMenuStyle" TargetType="Menu" BasedOn="{StaticResource {x:Type Menu}}">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Compact top-level header. The WPF UI template carries fixed margins (about 46 px tall) that do not fit the menu bar:
       the header text was pushed onto the bar's bottom edge and cut off. Same brushes and popup as the WPF UI template.
       Tokens: Spacing1Horizontal, MenuTopLevelPadding, CornerRadiusSm, CornerRadiusMd, BorderAll, Spacing1Vertical -->
  <ControlTemplate x:Key="AppMenuTopLevelHeaderTemplate" TargetType="MenuItem">
    <Border x:Name="HeaderBorder" Margin="{StaticResource Spacing1Horizontal}"
            CornerRadius="{StaticResource CornerRadiusSm}" Background="Transparent">
      <Grid>
        <ContentPresenter Margin="{StaticResource MenuTopLevelPadding}" VerticalAlignment="Center"
                          ContentSource="Header" RecognizesAccessKey="True" />
        <Popup x:Name="SubmenuPopup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
               PopupAnimation="None" IsOpen="{TemplateBinding IsSubmenuOpen}">
          <Border BorderThickness="{StaticResource BorderAll}" Padding="{StaticResource Spacing1Vertical}"
                  CornerRadius="{StaticResource CornerRadiusMd}"
                  BorderBrush="{DynamicResource FlyoutBorderBrush}" Background="{DynamicResource FlyoutBackground}">
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
          </Border>
        </Popup>
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource MenuBarItemBackgroundSelected}" />
      </Trigger>
      <Trigger Property="IsSubmenuOpen" Value="True">
        <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource MenuBarItemBackgroundPressed}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- Tokens: FontSizeSm, TextFillColorPrimaryBrush -->
  <Style x:Key="AppMenuItemStyle" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Style.Triggers>
      <Trigger Property="Role" Value="TopLevelHeader">
        <Setter Property="Template" Value="{StaticResource AppMenuTopLevelHeaderTemplate}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== FORMAT TOOLBAR ===== -->

  <!-- Tokens: LayerFillColorDefaultBrush, ControlStrokeColorDefaultBrush, BorderBottom, Spacing1 -->
  <Style x:Key="FormatToolBarStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource BorderBottom}" />
    <Setter Property="Padding" Value="{StaticResource Spacing1}" />
  </Style>

  <!-- Tokens: Spacing1 (margin), Spacing2 (padding). Not focusable so the editor keeps the keyboard focus. -->
  <Style x:Key="ToolBarButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
    <Setter Property="Appearance" Value="Transparent" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Margin" Value="{StaticResource Spacing1}" />
    <Setter Property="Padding" Value="{StaticResource Spacing2}" />
  </Style>

  <!-- Tokens: IconSizeMd, TextFillColorSecondaryBrush -->
  <Style x:Key="ToolBarIconStyle" TargetType="ui:SymbolIcon">
    <Setter Property="FontSize" Value="{StaticResource IconSizeMd}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>

  <!-- Tokens: BorderWidth, Spacing1Vertical, ControlStrokeColorDefaultBrush -->
  <Style x:Key="ToolBarDividerStyle" TargetType="Border">
    <Setter Property="Width" Value="{StaticResource BorderWidth}" />
    <Setter Property="Margin" Value="{StaticResource Spacing1}" />
    <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
  </Style>

  <!-- ===== EXPLORER ===== -->

  <!-- Tokens: LayerFillColorDefaultBrush, ControlStrokeColorDefaultBrush, BorderRight -->
  <Style x:Key="ExplorerPaneStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource BorderRight}" />
  </Style>

  <!-- Tokens: FontSizeSm, FontWeightSemiBold, Spacing2, TextFillColorPrimaryBrush -->
  <Style x:Key="PaneTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="Margin" Value="{StaticResource Spacing2}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Tokens: BorderNone, Spacing1. Hidden while no folder is open. -->
  <Style x:Key="ExplorerTreeStyle" TargetType="TreeView" BasedOn="{StaticResource {x:Type TreeView}}">
    <Setter Property="BorderThickness" Value="{StaticResource BorderNone}" />
    <Setter Property="Padding" Value="{StaticResource Spacing1}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding HasFolder}" Value="False">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Tokens: FontSizeSm, TextFillColorPrimaryBrush. Two-way expansion and selection; the placeholder row stays hidden. -->
  <Style x:Key="ExplorerTreeItemStyle" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Tokens: IconSizeSm, TextFillColorSecondaryBrush, Spacing1Horizontal. Folder or document glyph. -->
  <Style x:Key="ExplorerNodeIconStyle" TargetType="ui:SymbolIcon">
    <Setter Property="Symbol" Value="Document24" />
    <Setter Property="FontSize" Value="{StaticResource IconSizeSm}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="Margin" Value="{StaticResource Spacing1Horizontal}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsDirectory}" Value="True">
        <Setter Property="Symbol" Value="Folder24" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Tokens: FontSizeSm. Foreground inherits from the item so the selected state stays readable. -->
  <Style x:Key="ExplorerNodeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- Tokens: Spacing4. Shown while no folder is open. -->
  <Style x:Key="ExplorerEmptyStateStyle" TargetType="StackPanel">
    <Setter Property="Margin" Value="{StaticResource Spacing4}" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding HasFolder}" Value="True">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Tokens: FontSizeSm, TextFillColorSecondaryBrush, Spacing2 -->
  <Style x:Key="EmptyStateTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="{StaticResource Spacing2}" />
  </Style>

  <!-- ===== OUTLINE ===== -->

  <!-- Tokens: BorderNone, Spacing1. Hidden while the document has no heading. -->
  <Style x:Key="OutlineTreeStyle" TargetType="TreeView" BasedOn="{StaticResource {x:Type TreeView}}">
    <Setter Property="BorderThickness" Value="{StaticResource BorderNone}" />
    <Setter Property="Padding" Value="{StaticResource Spacing1}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding HasHeadings}" Value="False">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Tokens: FontSizeSm, TextFillColorPrimaryBrush. Two-way expansion and selection (a selection is a click on the heading). -->
  <Style x:Key="OutlineTreeItemStyle" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <!-- Tokens: Spacing4 (through EmptyStateTextStyle). Shown while the document has no heading. -->
  <Style x:Key="OutlineEmptyStateTextStyle" TargetType="TextBlock" BasedOn="{StaticResource EmptyStateTextStyle}">
    <Setter Property="VerticalAlignment" Value="Top" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding HasHeadings}" Value="True">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Tokens: SplitterWidth, ControlStrokeColorDefaultBrush. Separates the explorer from the outline. Hidden while either pane is folded. -->
  <Style x:Key="PaneRowSplitterStyle" TargetType="GridSplitter" BasedOn="{StaticResource {x:Type GridSplitter}}">
    <Setter Property="Grid.Row" Value="1" />
    <Setter Property="Height" Value="{StaticResource SplitterWidth}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Explorer.IsPaneOpen}" Value="False">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Outline.IsPaneOpen}" Value="False">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Tokens: IconSizeMd, TextFillColorSecondaryBrush. Points down while the pane is open, right while it is folded. -->
  <Style x:Key="PaneToggleIconStyle" TargetType="ui:SymbolIcon" BasedOn="{StaticResource ToolBarIconStyle}">
    <Setter Property="Symbol" Value="ChevronDown24" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsPaneOpen}" Value="False">
        <Setter Property="Symbol" Value="ChevronRight24" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Tokens: Spacing1, Spacing2 (through ToolBarButtonStyle). -->
  <Style x:Key="PaneToggleButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource ToolBarButtonStyle}">
    <Setter Property="ToolTip" Value="{Binding Loc[Pane_Collapse]}" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Loc[Pane_Collapse]}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsPaneOpen}" Value="False">
        <Setter Property="ToolTip" Value="{Binding Loc[Pane_Expand]}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Loc[Pane_Expand]}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Tokens: SplitterWidth, ControlStrokeColorDefaultBrush. Resizes the left pane. Hidden with the pane. -->
  <Style x:Key="ExplorerColumnSplitterStyle" TargetType="GridSplitter" BasedOn="{StaticResource {x:Type GridSplitter}}">
    <Setter Property="Grid.Column" Value="1" />
    <Setter Property="Width" Value="{StaticResource SplitterWidth}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="ResizeDirection" Value="Columns" />
    <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
    <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding ExplorerVisible}" Value="False">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- ===== FIND AND REPLACE BAR ===== -->

  <!-- Tokens: CardBackgroundFillColorDefaultBrush, ControlStrokeColorDefaultBrush, BorderBottom, Spacing2. Hidden until opened. -->
  <Style x:Key="FindReplaceBarStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource BorderBottom}" />
    <Setter Property="Padding" Value="{StaticResource Spacing2}" />
    <Setter Property="Visibility" Value="Collapsed" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsVisible}" Value="True">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Tokens: FontSizeSm, Spacing1 -->
  <Style x:Key="FindTextBoxStyle" TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
    <Setter Property="Margin" Value="{StaticResource Spacing1}" />
  </Style>

  <!-- Tokens: FontSizeSm, Spacing1 -->
  <Style x:Key="BarButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
    <Setter Property="Margin" Value="{StaticResource Spacing1}" />
  </Style>

  <!-- Tokens: FontSizeSm, Spacing1 -->
  <Style x:Key="BarCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
    <Setter Property="Margin" Value="{StaticResource Spacing1}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ===== EDITOR AND PREVIEW ===== -->

  <!-- Tokens: FontFamilyMono, FontSizeSm, Spacing3, BorderNone. Keeps the selection visible while the find bar has focus. -->
  <Style x:Key="EditorTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="FontFamily" Value="{StaticResource FontFamilyMono}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
    <Setter Property="Padding" Value="{StaticResource Spacing3}" />
    <Setter Property="BorderThickness" Value="{StaticResource BorderNone}" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="IsInactiveSelectionHighlightEnabled" Value="True" />
  </Style>

  <!-- Tokens: ApplicationBackgroundBrush -->
  <Style x:Key="PreviewHostStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource ApplicationBackgroundBrush}" />
  </Style>

  <!-- No implicit Fluent style on this control. Hidden when the WebView2 runtime is missing. -->
  <Style x:Key="PreviewWebViewStyle" TargetType="wv2:WebView2CompositionControl">
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsAvailable}" Value="False">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Tokens: FontSizeSm, TextFillColorSecondaryBrush, Spacing4. Shown when the WebView2 runtime is missing. -->
  <Style x:Key="PreviewUnavailableTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="{StaticResource Spacing4}" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsAvailable}" Value="True">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- ===== LAYOUT SLOTS (view mode lives on the shell view model) ===== -->

  <!-- Hidden when the explorer is turned off. -->
  <Style x:Key="ExplorerSlotStyle" TargetType="Border">
    <Setter Property="Grid.Column" Value="0" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding ExplorerVisible}" Value="False">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Editor column; spans the whole area in editor-only mode, hidden in preview-only mode. -->
  <Style x:Key="EditorSlotStyle" TargetType="Border">
    <Setter Property="Grid.Column" Value="0" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding ViewMode}" Value="{x:Static models:ViewMode.EditorOnly}">
        <Setter Property="Grid.ColumnSpan" Value="3" />
      </DataTrigger>
      <DataTrigger Binding="{Binding ViewMode}" Value="{x:Static models:ViewMode.PreviewOnly}">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Preview column; spans the whole area in preview-only mode, hidden in editor-only mode. -->
  <Style x:Key="PreviewSlotStyle" TargetType="Border">
    <Setter Property="Grid.Column" Value="2" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding ViewMode}" Value="{x:Static models:ViewMode.EditorOnly}">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
      <DataTrigger Binding="{Binding ViewMode}" Value="{x:Static models:ViewMode.PreviewOnly}">
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="Grid.ColumnSpan" Value="3" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Tokens: SplitterWidth, ControlStrokeColorDefaultBrush. Only visible in split mode. -->
  <Style x:Key="PaneSplitterStyle" TargetType="GridSplitter" BasedOn="{StaticResource {x:Type GridSplitter}}">
    <Setter Property="Grid.Column" Value="1" />
    <Setter Property="Width" Value="{StaticResource SplitterWidth}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="Visibility" Value="Collapsed" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding ViewMode}" Value="{x:Static models:ViewMode.Split}">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- ===== STATUS BAR ===== -->

  <!-- Tokens: StatusBarHeight, LayerFillColorDefaultBrush, ControlStrokeColorDefaultBrush, BorderTop, Spacing3Horizontal -->
  <Style x:Key="StatusBarStyle" TargetType="Border">
    <Setter Property="Height" Value="{StaticResource StatusBarHeight}" />
    <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource BorderTop}" />
    <Setter Property="Padding" Value="{StaticResource Spacing3Horizontal}" />
  </Style>

  <!-- Tokens: FontSizeXs, TextFillColorSecondaryBrush, Spacing3Horizontal -->
  <Style x:Key="StatusBarTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="{StaticResource FontSizeXs}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="Margin" Value="{StaticResource Spacing3Horizontal}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- ===== FEEDBACK ===== -->

  <!-- Tokens: Spacing4, SnackbarWidth, ZSnackbar. Anchor: bottom-right (AppConfig.SnackbarPosition). No implicit style on this control. -->
  <Style x:Key="SnackbarBottomRightStyle" TargetType="ui:SnackbarPresenter">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="{StaticResource Spacing4}" />
    <Setter Property="MaxWidth" Value="{StaticResource SnackbarWidth}" />
    <Setter Property="Panel.ZIndex" Value="{StaticResource ZSnackbar}" />
  </Style>
</ResourceDictionary>
