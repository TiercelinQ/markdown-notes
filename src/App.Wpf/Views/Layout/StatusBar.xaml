<UserControl x:Class="MarkdownNotes.Views.Layout.StatusBar"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource StatusBarStyle}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Style="{StaticResource StatusBarTextStyle}" Text="{Binding Editor.FilePath}" />
      <TextBlock Grid.Column="1" Style="{StaticResource StatusBarTextStyle}" Text="{Binding StatusText}" />
      <TextBlock Grid.Column="2" Style="{StaticResource StatusBarTextStyle}" Text="{Binding ModifiedText}" />
      <TextBlock Grid.Column="3" Style="{StaticResource StatusBarTextStyle}" Text="{Binding CursorText}" />
    </Grid>
  </Border>
</UserControl>
