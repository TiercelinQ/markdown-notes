<UserControl x:Class="MarkdownNotes.Views.Layout.AppMenuBar"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:MarkdownNotes.Models">
  <Border Style="{StaticResource MenuBarBorderStyle}">
    <Menu Style="{StaticResource AppMenuStyle}">
      <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[Menu_File]}">
        <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[Menu_File_New]}"
                  Command="{Binding NewCommand}" InputGestureText="Ctrl+N" />
        <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[Menu_File_Open]}"
                  Command="{Binding OpenCommand}" InputGestureText="Ctrl+O" />
        <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[Menu_File_OpenFolder]}"
                  Command="{Binding OpenFolderCommand}" />
        <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[Menu_File_Recent]}"
                  IsEnabled="{Binding HasRecentFiles}" ItemsSource="{Binding RecentFiles}">
          <MenuItem.ItemContainerStyle>
            <Style TargetType="MenuItem" BasedOn="{StaticResource AppMenuItemStyle}">
              <Setter Property="Command" Value="{Binding DataContext.OpenPathCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
              <Setter Property="CommandParameter" Value="{Binding}" />
            </Style>
          </MenuItem.ItemContainerStyle>
          <MenuItem.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" />
            </DataTemplate>
          </MenuItem.ItemTemplate>
        </MenuItem>
        <Separator />
        <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[Menu_File_Save]}"
                  Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
        <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[Menu_File_SaveAs]}"
                  Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S" />
        <Separator />
        <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[Menu_File_Exit]}"
                  Command="{Binding ExitCommand}" InputGestureText="Alt+F4" />
      </MenuItem>

      <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[Menu_Edit]}">
        <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[Menu_Edit_Undo]}"
                  Command="ApplicationCommands.Undo" />
        <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[Menu_Edit_Redo]}"
                  Command="ApplicationCommands.Redo" />
        <Separator />
        <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[Menu_Edit_Cut]}"
                  Command="ApplicationCommands.Cut" />
        <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[Menu_Edit_Copy]}"
                  Command="ApplicationCommands.Copy" />
        <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[Menu_Edit_Paste]}"
                  Command="ApplicationCommands.Paste" />
        <Separator />
        <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[Menu_Edit_Find]}"
                  Command="{Binding ShowFindCommand}" InputGestureText="Ctrl+F" />
        <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[Menu_Edit_Replace]}"
                  Command="{Binding ShowReplaceCommand}" InputGestureText="Ctrl+H" />
      </MenuItem>

      <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[Menu_Format]}">
        <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[Format_Bold]}"
                  Command="{Binding Editor.FormatCommand}" CommandParameter="{x:Static models:FormatKind.Bold}"
                  InputGestureText="Ctrl+B" />
        <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[Format_Italic]}"
                  Command="{Binding Editor.FormatCommand}" CommandParameter="{x:Static models:FormatKind.Italic}"
                  InputGestureText="Ctrl+I" />
        <Separator />
        <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[Format_Heading1]}"
                  Command="{Binding Editor.FormatCommand}" CommandParameter="{x:Static models:FormatKind.Heading1}" />
        <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[Format_Heading2]}"
                  Command="{Binding Editor.FormatCommand}" CommandParameter="{x:Static models:FormatKind.Heading2}" />
        <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[Format_Heading3]}"
                  Command="{Binding Editor.FormatCommand}" CommandParameter="{x:Static models:FormatKind.Heading3}" />
        <Separator />
        <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[Format_BulletList]}"
                  Command="{Binding Editor.FormatCommand}" CommandParameter="{x:Static models:FormatKind.BulletList}" />
        <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[Format_NumberedList]}"
                  Command="{Binding Editor.FormatCommand}" CommandParameter="{x:Static models:FormatKind.NumberedList}" />
        <Separator />
        <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[Format_Link]}"
                  Command="{Binding Editor.FormatCommand}" CommandParameter="{x:Static models:FormatKind.Link}"
                  InputGestureText="Ctrl+K" />
        <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[Format_Code]}"
                  Command="{Binding Editor.FormatCommand}" CommandParameter="{x:Static models:FormatKind.Code}" />
        <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[Format_Quote]}"
                  Command="{Binding Editor.FormatCommand}" CommandParameter="{x:Static models:FormatKind.Quote}" />
      </MenuItem>

      <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[Menu_View]}">
        <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[View_Mode_Split]}"
                  IsCheckable="True" IsChecked="{Binding IsSplitMode, Mode=OneWay}"
                  Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:ViewMode.Split}" />
        <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[View_Mode_Editor]}"
                  IsCheckable="True" IsChecked="{Binding IsEditorOnlyMode, Mode=OneWay}"
                  Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:ViewMode.EditorOnly}" />
        <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[View_Mode_Preview]}"
                  IsCheckable="True" IsChecked="{Binding IsPreviewOnlyMode, Mode=OneWay}"
                  Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:ViewMode.PreviewOnly}" />
        <Separator />
        <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[View_Explorer]}"
                  IsCheckable="True" IsChecked="{Binding ExplorerVisible, Mode=OneWay}"
                  Command="{Binding ToggleExplorerCommand}" />
        <Separator />
        <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[View_Theme]}">
          <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[View_Theme_Light]}"
                    IsCheckable="True" IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                    Command="{Binding SetThemeCommand}" CommandParameter="{x:Static models:AppTheme.Light}" />
          <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[View_Theme_Dark]}"
                    IsCheckable="True" IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                    Command="{Binding SetThemeCommand}" CommandParameter="{x:Static models:AppTheme.Dark}" />
        </MenuItem>
      </MenuItem>

      <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[Menu_Language]}">
        <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[Language_French]}"
                  IsCheckable="True" IsChecked="{Binding IsFrench, Mode=OneWay}"
                  Command="{Binding SetLanguageCommand}" CommandParameter="fr" />
        <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="{Binding Loc[Language_English]}"
                  IsCheckable="True" IsChecked="{Binding IsEnglish, Mode=OneWay}"
                  Command="{Binding SetLanguageCommand}" CommandParameter="en" />
      </MenuItem>
    </Menu>
  </Border>
</UserControl>
