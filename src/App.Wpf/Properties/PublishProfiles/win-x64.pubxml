<?xml version="1.0" encoding="utf-8"?>
<!--
  Portable publish profile: one self-contained win-x64 executable, no runtime to install.

  Run (project path is mandatory, the application must be closed):
      dotnet publish src/App.Wpf -c Release -p:PublishProfile=win-x64

  Output: publish/win-x64/MarkdownNotes.exe
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <!-- Same target as Directory.Build.props (WebView2CompositionControl needs the 10.0.17763.0 SDK projection). -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Native WPF libraries are bundled in the executable, otherwise they stay loose beside it. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Faster cold start, larger binary. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- WPF relies on reflection over XAML types and is not trim-safe. Never set to true. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- The publish folder holds the executable and nothing else. -->
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishDir>..\..\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
