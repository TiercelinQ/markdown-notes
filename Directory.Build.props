<Project>
  <!-- Shared compiler settings. TreatWarningsAsErrors is not negotiable: fix the cause, never silence the rule. -->
  <PropertyGroup>
    <!-- 10.0.17763.0: WebView2CompositionControl loads the Windows SDK projection (Microsoft.Windows.SDK.NET). -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Published file properties. AssemblyVersion, FileVersion and InformationalVersion derive from the project Version. -->
    <Company>Markdown Notes</Company>
    <Product>Markdown Notes</Product>
    <Copyright>Copyright (c) 2026</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
